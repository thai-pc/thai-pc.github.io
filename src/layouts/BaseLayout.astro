---
import { langList, dirFor, localePath, type Lang } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  // Route suffix passed to localePath() to build this page's per-locale hreflang
  // alternates (e.g. "product" for /product and /vi/product). Default '' = home.
  path?: string;
  // false for English-only pages (privacy/terms) that have no per-locale variant —
  // emitting hreflang alternates pointing at unrelated locale homepages would be
  // actively wrong, so these pages skip the hreflang block entirely.
  translated?: boolean;
}

const { title, description, lang, path = '', translated = true } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const dir = dirFor(lang);
// Astro's static build uses directory format (/product/index.html), served canonically
// as "/product/" — localePath() itself must NOT add this slash, since it's also used
// for hash-anchor links (localePath(lang, '#install')) where a trailing slash would
// break the anchor. So the slash is added only here, for real page routes.
const routeSuffix = path ? `${path}/` : '';
---

<!doctype html>
<html lang={lang} dir={dir} class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {translated && langList.map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={new URL(localePath(l, routeSuffix), Astro.site)}
      />
    ))}
    {translated && (
      <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', routeSuffix), Astro.site)} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={lang} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />

    <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        var raw = localStorage.getItem('theme');
        var mode = raw === 'light' || raw === 'dark' || raw === 'system' ? raw : 'system';
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var useDark = mode === 'dark' || (mode === 'system' && prefersDark);
        var root = document.documentElement;
        root.classList.toggle('dark', useDark);
        root.dataset.themeMode = mode;
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "FluxFiles",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Any",
      // The MIT core is genuinely $0, but the same product line also sells
      // Pro/Studio tiers on top (see Pricing.astro) — an AggregateOffer with
      // the real monthly range is more honest than a flat "$0" that ignores
      // the paid tiers entirely. Keep these numbers in sync with
      // Pricing.astro's `tiers` monthly prices; Enterprise is "Custom" and
      // has no numeric price, so it's excluded from the count/range.
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "USD",
        "lowPrice": "0",
        "highPrice": "29",
        "offerCount": "3"
      },
      "license": "https://opensource.org/licenses/MIT"
    })} />
  </head>
  <body class="min-h-screen font-sans antialiased">
    <slot />
    <script is:inline src="https://cdn.jsdelivr.net/npm/alpinejs@3.16.3/dist/cdn.min.js" integrity="sha384-GWGIn3FlbC6EIhIhKi0GSHWq/UCqPc7qpVE5J/bsAW8FMyMAyA08W86xYxy+8i5/" crossorigin="anonymous" defer></script>
    <script is:inline>
      (function () {
        var KEY = 'theme';
        var MEDIA = window.matchMedia('(prefers-color-scheme: dark)');
        var ARIA = {
          light: 'Color theme: light. Click for dark.',
          dark: 'Color theme: dark. Click for system.',
          system: 'Color theme: match system. Click for light.'
        };
        function getMode() {
          var raw = localStorage.getItem(KEY);
          return raw === 'light' || raw === 'dark' || raw === 'system' ? raw : 'system';
        }
        function applyTheme(fromMode) {
          var mode = fromMode !== undefined ? fromMode : getMode();
          var useDark = mode === 'dark' || (mode === 'system' && MEDIA.matches);
          var root = document.documentElement;
          root.classList.toggle('dark', useDark);
          root.dataset.themeMode = mode;
          document.querySelectorAll('.theme-cycle').forEach(function (el) {
            el.setAttribute('aria-label', ARIA[mode] || ARIA.system);
          });
        }
        function nextMode(current) {
          if (current === 'light') return 'dark';
          if (current === 'dark') return 'system';
          return 'light';
        }
        MEDIA.addEventListener('change', function () {
          if (getMode() === 'system') applyTheme();
        });
        document.addEventListener('click', function (e) {
          var btn = e.target && e.target.closest && e.target.closest('.theme-cycle');
          if (!btn) return;
          var n = nextMode(getMode());
          localStorage.setItem(KEY, n);
          applyTheme(n);
        });
        document.addEventListener('DOMContentLoaded', function () {
          applyTheme();
        });
      })();
    </script>
  </body>
</html>
