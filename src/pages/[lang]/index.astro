---
import HomeBody from '../../sections/pages/HomeBody.astro';
import { langList, defaultLang, type Lang } from '../../i18n/utils';

export function getStaticPaths() {
  // defaultLang is served at `/` (pages/index.astro) — generating `/en/` too would be a
  // byte-for-byte duplicate page with its own self-referencing canonical, which conflicts
  // with the hreflang alternate that also points `en` at `/`.
  return langList.filter((lang) => lang !== defaultLang).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---

<HomeBody lang={lang} />
