---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const REPO = 'https://github.com/thai-pc/fluxfiles';

const cards = [
  { titleKey: 'docs.card_quickstart_title', descKey: 'docs.card_quickstart_desc', href: `${REPO}#quick-start` },
  { titleKey: 'docs.card_config_title', descKey: 'docs.card_config_desc', href: `${REPO}/blob/master/docs/CONFIG.md` },
  { titleKey: 'docs.card_api_title', descKey: 'docs.card_api_desc', href: `${REPO}/blob/master/docs/API.md` },
  { titleKey: 'docs.card_selfhost_title', descKey: 'docs.card_selfhost_desc', href: `${REPO}/blob/master/docs/DEPLOYMENT.md` },
];
---

<BaseLayout title={t('meta.docs_title')} description={t('meta.docs_description')} lang={lang} path="docs">
  <Navbar lang={lang} />
  <main>
    <section class="py-20 sm:py-28">
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <p class="text-sm font-semibold uppercase tracking-wide text-accent dark:text-accent-dark mb-3">{t('docs.label')}</p>
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100">{t('docs.headline')}</h1>
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">{t('docs.sub')}</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {cards.map((c) => (
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900/40 p-6 hover:border-accent/40 hover:shadow-lg transition-all"
            >
              <div class="flex items-center justify-between">
                <h2 class="font-semibold text-gray-900 dark:text-gray-100">{t(c.titleKey)}</h2>
                <svg class="w-4 h-4 text-gray-400 group-hover:text-accent transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 7L7 17M7 7h10v10" /></svg>
              </div>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{t(c.descKey)}</p>
              <span class="mt-4 text-xs font-medium text-accent dark:text-accent-dark">{t('docs.view')}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
