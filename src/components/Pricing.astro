---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// ── Polar checkout links ────────────────────────────────────────────────────
// Reusable URLs generated by `polar checkout-links`; each carries its product and the
// success URL, so this page needs no API token and stays fully static.
//
// They come from PUBLIC_ env vars so the same build can point at sandbox or production
// without editing source — and so a missing one degrades to the existing "coming soon"
// button rather than a dead link. Regenerate with the ids from
// FluxFiles/services/license-server/polar-setup.php.
//
// PRICES BELOW ARE DUPLICATED in polar-setup.php. A static page cannot ask the API what
// a product costs, and an advertised price that differs from the charged one is the
// worst kind of bug to ship — change both together.
const CHECKOUT = {
  pro_monthly: import.meta.env.PUBLIC_POLAR_PRO_MONTHLY ?? '',
  pro_yearly: import.meta.env.PUBLIC_POLAR_PRO_YEARLY ?? '',
  studio_monthly: import.meta.env.PUBLIC_POLAR_STUDIO_MONTHLY ?? '',
  studio_yearly: import.meta.env.PUBLIC_POLAR_STUDIO_YEARLY ?? '',
};
const CONTACT = 'mailto:sales@fluxfiles.dev?subject=FluxFiles%20Enterprise';

// Each buy-tier carries both prices; the Alpine toggle swaps which one shows.
const tiers = [
  {
    id: 'free',
    name: t('pricing.free_name'),
    monthly: '$0', yearly: '$0',
    desc: t('pricing.free_desc'),
    features: ['free_f1', 'free_f2', 'free_f3', 'free_f4'].map((k) => t(`pricing.${k}`)),
    cta: t('pricing.free_cta'),
    hrefMonthly: `/${lang}/#install`, hrefYearly: `/${lang}/#install`,
    featured: false, style: 'plain',
  },
  {
    id: 'pro',
    name: t('pricing.pro_name'),
    monthly: '$9', yearly: '$79',
    desc: t('pricing.pro_desc'),
    features: ['pro_f1', 'pro_f2', 'pro_f3', 'pro_f4'].map((k) => t(`pricing.${k}`)),
    cta: t('pricing.pro_cta'),
    hrefMonthly: CHECKOUT.pro_monthly, hrefYearly: CHECKOUT.pro_yearly,
    featured: true, style: 'buy',
  },
  {
    id: 'studio',
    name: t('pricing.studio_name'),
    monthly: '$29', yearly: '$299',
    desc: t('pricing.studio_desc'),
    features: ['studio_f1', 'studio_f2', 'studio_f3', 'studio_f4'].map((k) => t(`pricing.${k}`)),
    cta: t('pricing.studio_cta'),
    hrefMonthly: CHECKOUT.studio_monthly, hrefYearly: CHECKOUT.studio_yearly,
    featured: false, style: 'buy',
  },
  {
    id: 'enterprise',
    name: t('pricing.ent_name'),
    monthly: t('pricing.custom'), yearly: t('pricing.custom'),
    desc: t('pricing.ent_desc'),
    features: ['ent_f1', 'ent_f2', 'ent_f3', 'ent_f4'].map((k) => t(`pricing.${k}`)),
    cta: t('pricing.ent_cta'),
    hrefMonthly: CONTACT, hrefYearly: CONTACT,
    featured: false, style: 'contact',
  },
];
---

<section id="pricing" class="py-20 sm:py-28" x-data="{ annual: true }">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">{t('pricing.eyebrow')}</p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">
        {t('pricing.headline')}
      </h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">{t('pricing.sub')}</p>

      <!-- Monthly / Annual toggle -->
      <div class="mt-8 inline-flex items-center gap-3 rounded-full bg-gray-100 dark:bg-gray-800 p-1 text-sm font-medium">
        <button
          type="button"
          @click="annual = false"
          :class="!annual ? 'bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow' : 'text-gray-500 dark:text-gray-400'"
          class="rounded-full px-4 py-1.5 transition-colors"
        >{t('pricing.monthly')}</button>
        <button
          type="button"
          @click="annual = true"
          :class="annual ? 'bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow' : 'text-gray-500 dark:text-gray-400'"
          class="rounded-full px-4 py-1.5 transition-colors inline-flex items-center gap-1.5"
        >
          {t('pricing.annual')}
          <span class="rounded-full bg-accent/15 px-1.5 py-0.5 text-[11px] font-semibold text-accent">{t('pricing.save')}</span>
        </button>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-4 items-start">
      {tiers.map((tier) => (
        <div
          class:list={[
            'relative flex flex-col rounded-2xl p-6 sm:p-7 transition-shadow',
            tier.featured
              ? 'bg-white dark:bg-gray-900 ring-2 ring-accent shadow-xl shadow-accent/15 lg:-mt-4 lg:mb-4'
              : 'bg-white dark:bg-gray-900 ring-1 ring-gray-200 dark:ring-gray-800 hover:shadow-lg',
          ]}
        >
          {tier.featured && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-accent px-3 py-1 text-xs font-semibold text-white shadow">
              {t('pricing.popular')}
            </span>
          )}
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{tier.name}</h3>
          <div class="mt-3 flex items-baseline gap-1">
            <span
              class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white"
              x-text={`annual ? '${tier.yearly}' : '${tier.monthly}'`}
            >{tier.yearly}</span>
            {tier.style === 'buy' && (
              <span class="text-sm text-gray-500 dark:text-gray-400" x-text={`annual ? '${t('pricing.per_year')}' : '${t('pricing.per_month')}'`}>{t('pricing.per_year')}</span>
            )}
            {tier.id === 'free' && <span class="text-sm text-gray-500 dark:text-gray-400">{t('pricing.forever')}</span>}
          </div>
          <p class="mt-3 text-sm text-gray-600 dark:text-gray-400 min-h-[2.5rem]">{tier.desc}</p>

          {tier.style === 'buy' ? (
            <>
              {/* annual + monthly buy links; the toggle shows one. '' → coming soon. */}
              {tier.hrefYearly ? (
                <a href={tier.hrefYearly} x-show="annual"
                  class:list={['mt-6 inline-flex w-full items-center justify-center rounded-lg px-5 py-3 text-sm font-semibold transition-colors',
                    tier.featured ? 'bg-accent text-white hover:bg-accent/90 shadow-lg shadow-accent/25' : 'bg-gray-900 text-white hover:bg-gray-700 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200']}>{tier.cta}</a>
              ) : (
                <span x-show="annual" class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-800 px-5 py-3 text-sm font-semibold text-gray-400 cursor-not-allowed">{t('pricing.soon')}</span>
              )}
              {tier.hrefMonthly ? (
                <a href={tier.hrefMonthly} x-show="!annual" x-cloak
                  class:list={['mt-6 inline-flex w-full items-center justify-center rounded-lg px-5 py-3 text-sm font-semibold transition-colors',
                    tier.featured ? 'bg-accent text-white hover:bg-accent/90 shadow-lg shadow-accent/25' : 'bg-gray-900 text-white hover:bg-gray-700 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200']}>{tier.cta}</a>
              ) : (
                <span x-show="!annual" x-cloak class="mt-6 inline-flex w-full items-center justify-center rounded-lg bg-gray-100 dark:bg-gray-800 px-5 py-3 text-sm font-semibold text-gray-400 cursor-not-allowed">{t('pricing.soon')}</span>
              )}
            </>
          ) : (
            <a href={tier.hrefYearly}
              class="mt-6 inline-flex w-full items-center justify-center rounded-lg px-5 py-3 text-sm font-semibold transition-colors ring-1 ring-gray-300 dark:ring-gray-700 text-gray-900 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-800">{tier.cta}</a>
          )}

          <ul class="mt-7 space-y-3 text-sm">
            {tier.features.map((f) => (
              <li class="flex items-start gap-2.5">
                <svg class="mt-0.5 w-4 h-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700 dark:text-gray-300" set:html={f}></span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="mt-10 text-center text-sm text-gray-500 dark:text-gray-400">
      {t('pricing.footnote')}
    </p>
  </div>
</section>

<!-- No checkout script: Polar checkout links are ordinary navigations, so the page
     keeps working with JavaScript disabled and loads nothing third-party. -->
