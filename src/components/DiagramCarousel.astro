---
import { useTranslations, type Lang } from '../i18n/utils';

interface Item {
  key: string;
  caption: string;
  json?: string;
}

interface Props {
  items: Item[];
  lang: Lang;
}

const { items, lang } = Astro.props;
const t = useTranslations(lang);

// Shared input → process → output visual grammar for every concept diagram —
// the per-module text (caption) carries the meaning, the icons stay generic
// so all Studio/Enterprise cards read as one consistent "how it works" family.
const ICON_IN = `<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />`;
const ICON_PROCESS = `<path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.43.992a7.723 7.723 0 010 .255c-.008.378.137.75.43.99l1.004.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />`;
const ICON_OUT = `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />`;
const CHEVRON = `<path fill-rule="evenodd" d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 11-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />`;
---

<div
  class="rounded-xl border border-[var(--border-default)] bg-[var(--bg-elevated)] overflow-hidden shadow-lg shadow-black/5 dark:shadow-black/30"
  data-screenshot-carousel
>
  <div class="relative">
    <div class="flex transition-transform duration-300 ease-out will-change-transform" data-carousel-track>
      {items.map((d) => (
        <figure class="w-full shrink-0" data-carousel-slide>
          <div class="relative w-full aspect-[4/3] sm:aspect-[16/9] lg:aspect-[21/9] bg-[var(--bg-page)] flex flex-col items-center justify-center gap-5 px-6">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-accent/20 bg-accent-light dark:bg-accent/10 px-2.5 py-1 text-[11px] font-medium text-accent dark:text-accent-dark">
              {t('demo.concept_label')}
            </span>
            <div class="flex items-center gap-2 sm:gap-4">
              <span class="inline-flex items-center justify-center w-11 h-11 sm:w-14 sm:h-14 rounded-xl bg-accent-light dark:bg-accent/15 text-accent shrink-0">
                <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" set:html={ICON_IN} />
              </span>
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[var(--text-secondary)] shrink-0" fill="currentColor" viewBox="0 0 20 20" set:html={CHEVRON} />
              {d.json ? (
                <pre class="rounded-lg bg-[var(--bg-page)] border border-[var(--border-default)] px-3 py-2 text-[9px] sm:text-[11px] leading-snug text-[var(--text-secondary)] whitespace-pre shrink-0">{d.json}</pre>
              ) : (
                <span class="inline-flex items-center justify-center w-11 h-11 sm:w-14 sm:h-14 rounded-xl bg-accent-light dark:bg-accent/15 text-accent shrink-0">
                  <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" set:html={ICON_PROCESS} />
                </span>
              )}
              <svg class="w-4 h-4 sm:w-5 sm:h-5 text-[var(--text-secondary)] shrink-0" fill="currentColor" viewBox="0 0 20 20" set:html={CHEVRON} />
              <span class="inline-flex items-center justify-center w-11 h-11 sm:w-14 sm:h-14 rounded-xl bg-accent-light dark:bg-accent/15 text-accent shrink-0">
                <svg class="w-6 h-6 sm:w-7 sm:h-7" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" set:html={ICON_OUT} />
              </span>
            </div>
            <p class="text-sm text-center text-[var(--text-secondary)] max-w-md">{d.caption}</p>
          </div>
        </figure>
      ))}
    </div>

    <button
      type="button"
      class="absolute left-3 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-9 h-9 rounded-full border border-[var(--border-default)] bg-[var(--bg-page)]/90 text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-page)] transition-colors backdrop-blur"
      aria-label="Previous slide"
      data-carousel-prev
    >
      <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M12.707 15.707a1 1 0 01-1.414 0l-5-5a1 1 0 010-1.414l5-5a1 1 0 111.414 1.414L8.414 10l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
      </svg>
    </button>
    <button
      type="button"
      class="absolute right-3 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-9 h-9 rounded-full border border-[var(--border-default)] bg-[var(--bg-page)]/90 text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-page)] transition-colors backdrop-blur"
      aria-label="Next slide"
      data-carousel-next
    >
      <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 11-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </button>
  </div>

  <div class="flex items-center justify-center gap-2 py-3 border-t border-[var(--border-default)] bg-[var(--bg-elevated)]" data-carousel-dots>
    {items.map((_, idx) => (
      <button
        type="button"
        class="w-2.5 h-2.5 rounded-full border border-[var(--border-default)] bg-[var(--bg-page)] hover:bg-[var(--bg-subtle)] transition-colors"
        aria-label={`Go to slide ${idx + 1}`}
        data-carousel-dot={idx}
      />
    ))}
  </div>
</div>
