---
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const products = [
  {
    key: 'share',
    tag: t('products.share_tag'),
    name: t('products.share_name'),
    desc: t('products.share_desc'),
    features: ['share_f1', 'share_f2', 'share_f3'].map((k) => t(`products.${k}`)),
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />`,
    featured: true,
  },
  {
    key: 'intake',
    tag: t('products.intake_tag'),
    name: t('products.intake_name'),
    desc: t('products.intake_desc'),
    features: ['intake_f1', 'intake_f2', 'intake_f3'].map((k) => t(`products.${k}`)),
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />`,
    featured: true,
  },
  {
    key: 'compliance',
    tag: t('products.compliance_tag'),
    name: t('products.compliance_name'),
    desc: t('products.compliance_desc'),
    features: [],
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />`,
    featured: false,
  },
];
---

<section id="products" class="py-20 sm:py-28 bg-gray-50/60 dark:bg-gray-900/40">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wider text-accent">{t('products.label')}</p>
      <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-white">
        {t('products.headline')}
      </h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">{t('products.sub')}</p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-3 items-start">
      {products.map((p) => (
        <div
          class:list={[
            'flex flex-col rounded-2xl p-6 sm:p-7 bg-white dark:bg-gray-900 transition-shadow',
            p.featured
              ? 'ring-2 ring-accent/30 shadow-lg shadow-accent/5 hover:shadow-xl'
              : 'ring-1 ring-gray-200 dark:ring-gray-800 hover:shadow-lg',
          ]}
        >
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center justify-center w-11 h-11 rounded-xl bg-accent-light dark:bg-accent/15 text-accent">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24" set:html={p.icon}></svg>
            </span>
            <span class="rounded-full bg-accent/10 px-2.5 py-1 text-xs font-semibold text-accent">{p.tag}</span>
          </div>
          <h3 class="mt-4 text-xl font-semibold text-gray-900 dark:text-white">{p.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600 dark:text-gray-400">{p.desc}</p>
          {p.features.length > 0 && (
            <ul class="mt-5 space-y-2.5 text-sm">
              {p.features.map((f) => (
                <li class="flex items-start gap-2.5">
                  <svg class="mt-0.5 w-4 h-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-gray-700 dark:text-gray-300">{f}</span>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    <div class="mt-10 text-center">
      <a href={`/${lang}/#pricing`} class="inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-accent/25 hover:bg-accent/90 transition-colors">
        {t('products.cta')}
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
      </a>
    </div>
  </div>
</section>
