---
import { useTranslations, type Lang } from '../i18n/utils';
import ScreenshotCarousel from './ScreenshotCarousel.astro';
import DiagramCarousel from './DiagramCarousel.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const freeScreenshots = [
  { src: '/demo/fluxfiles-demo-desktop.png', alt: 'FluxFiles desktop file manager with image thumbnails', caption: t('demo.cap_desktop') },
  { src: '/demo/fluxfiles-demo-s3.png', alt: 'FluxFiles browsing an S3 / R2 bucket with the local, S3 and SFTP disk switcher', caption: t('demo.cap_s3') },
  { src: '/demo/fluxfiles-demo-sftp.png', alt: 'FluxFiles managing a remote VPS deploy directory over SFTP, same UI as the S3 bucket', caption: t('demo.cap_sftp') },
  { src: '/demo/fluxfiles-demo-editor.png', alt: 'Editing an nginx config file inside FluxFiles with syntax highlighting', caption: t('demo.cap_editor') },
  { src: '/demo/fluxfiles-demo-media-preview.png', alt: 'FluxFiles previewing a video inline in the detail panel', caption: t('demo.cap_media') },
  { src: '/demo/fluxfiles-demo-doctor.png', alt: 'FluxFiles Bucket Doctor health checks for an S3 bucket with CORS and IAM remediation', caption: t('demo.cap_doctor') },
  { src: '/demo/fluxfiles-demo-activity.png', alt: 'FluxFiles activity log of file operations', caption: t('demo.cap_activity') },
  { src: '/demo/fluxfiles-demo-trash.png', alt: 'FluxFiles trash with restore and delete forever', caption: t('demo.cap_trash') },
  { src: '/demo/fluxfiles-demo-ai-tag.png', alt: 'FluxFiles free AI auto-tag panel generating searchable tags for an image', caption: t('demo.cap_ai_tag') },
  { src: '/demo/fluxfiles-demo-mobile.png', alt: 'FluxFiles responsive mobile file manager', caption: t('demo.cap_mobile') },
];

const proScreenshots = [
  { src: '/demo/fluxfiles-demo-share-create.png', alt: 'Creating a FluxFiles share link with an expiry, a password and a download limit', caption: t('demo.cap_share') },
  { src: '/demo/fluxfiles-demo-intake-create.png', alt: 'Creating a FluxFiles upload portal with a file limit, size cap and allowed file types', caption: t('demo.cap_intake') },
  { src: '/demo/fluxfiles-demo-links-panel.png', alt: 'FluxFiles links panel listing shared links with views, downloads and revoke', caption: t('demo.cap_links') },
];

const studioScreenshots = [
  { src: '/demo/fluxfiles-demo-ai-vision.png', alt: 'FluxFiles AI Vision panel removing the background from an image with your own vision API key', caption: t('demo.cap_ai_vision') },
];

const studioDiagrams = [
  { key: 'versioning', caption: t('demo.cap_versioning') },
  { key: 'webhooks', caption: t('demo.cap_webhooks'), json: '{ "event": "upload",\n  "file": "invoice.pdf" }' },
  { key: 'ocr', caption: t('demo.cap_ocr') },
];

const enterpriseDiagrams = [
  { key: 'virus', caption: t('demo.cap_virus') },
  { key: 'c2pa', caption: t('demo.cap_c2pa') },
  { key: 'backup', caption: t('demo.cap_backup') },
  { key: 'audit-export', caption: t('demo.cap_audit_export') },
  { key: 'sso', caption: t('demo.cap_sso') },
];

const tabs = [
  { key: 'free', label: t('demo.tab_free') },
  { key: 'pro', label: t('demo.tab_pro') },
  { key: 'studio', label: t('demo.tab_studio') },
  { key: 'enterprise', label: t('demo.tab_enterprise') },
];
---

<section id="screenshots" class="py-16 sm:py-20" aria-label="Product screenshots" x-data="{ tab: 'free' }">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <div class="inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent-light dark:bg-accent/10 px-3 py-1 text-xs font-medium text-accent dark:text-accent-dark mb-4">
        {t('demo.label')}
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100">
        {t('demo.headline')}
      </h2>
    </div>

    <div class="flex justify-center mb-8">
      <div class="inline-flex flex-wrap items-center justify-center gap-1 rounded-full bg-gray-100 dark:bg-gray-800 p-1 text-sm font-medium">
        {tabs.map((tb) => (
          <button
            type="button"
            @click={`tab = '${tb.key}'`}
            x-bind:class={`tab === '${tb.key}' ? 'bg-white dark:bg-gray-900 text-gray-900 dark:text-white shadow' : 'text-gray-500 dark:text-gray-400'`}
            class="rounded-full px-4 py-1.5 transition-colors"
          >{tb.label}</button>
        ))}
      </div>
    </div>

    <div x-show="tab === 'free'" x-cloak>
      <ScreenshotCarousel items={freeScreenshots} />
    </div>
    <div x-show="tab === 'pro'" x-cloak>
      <ScreenshotCarousel items={proScreenshots} />
    </div>
    <div x-show="tab === 'studio'" x-cloak class="space-y-6">
      <ScreenshotCarousel items={studioScreenshots} />
      <DiagramCarousel items={studioDiagrams} lang={lang} />
    </div>
    <div x-show="tab === 'enterprise'" x-cloak>
      <DiagramCarousel items={enterpriseDiagrams} lang={lang} />
    </div>

    <div
      class="fixed inset-0 z-[60] hidden flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm"
      data-carousel-modal
      role="dialog"
      aria-modal="true"
      aria-label="Screenshot preview"
    >
      <div class="absolute inset-0" data-carousel-modal-backdrop></div>

      <div class="relative w-full max-w-6xl">
        <div class="rounded-xl border border-[var(--border-default)] bg-[var(--bg-page)] shadow-2xl overflow-hidden">
          <div class="flex items-center justify-between px-4 py-3 border-b border-[var(--border-default)] bg-[var(--bg-elevated)]">
            <div class="text-sm font-medium" style="color: var(--text-secondary);" data-carousel-modal-title>
              {freeScreenshots[0].caption}
            </div>
            <button
              type="button"
              class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-[var(--border-default)] bg-[var(--bg-page)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-subtle)] transition-colors"
              aria-label="Close preview"
              data-carousel-modal-close
            >
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>

          <div class="relative bg-[var(--bg-page)]">
            <div class="w-full aspect-[4/3] sm:aspect-[16/9] bg-[var(--bg-page)]">
              <img
                src={freeScreenshots[0].src}
                alt={freeScreenshots[0].alt}
                class="h-full w-full object-contain"
                data-carousel-modal-image
              />
            </div>

            <button
              type="button"
              class="absolute left-3 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-10 h-10 rounded-full border border-[var(--border-default)] bg-[var(--bg-page)]/90 text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-page)] transition-colors backdrop-blur"
              aria-label="Previous screenshot"
              data-carousel-modal-prev
            >
              <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.707 15.707a1 1 0 01-1.414 0l-5-5a1 1 0 010-1.414l5-5a1 1 0 111.414 1.414L8.414 10l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
              </svg>
            </button>
            <button
              type="button"
              class="absolute right-3 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-10 h-10 rounded-full border border-[var(--border-default)] bg-[var(--bg-page)]/90 text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-page)] transition-colors backdrop-blur"
              aria-label="Next screenshot"
              data-carousel-modal-next
            >
              <svg class="w-5 h-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.293 4.293a1 1 0 011.414 0l5 5a1 1 0 010 1.414l-5 5a1 1 0 11-1.414-1.414L11.586 10 7.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    var AUTOPLAY_MS = 5000;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // One modal is shared by every carousel in a section (it's position:fixed,
    // a sibling of all the carousel roots). Wire its nav/close/keyboard handling
    // exactly ONCE here and track which carousel currently "owns" it — otherwise
    // every carousel's own listener would fire on the same keypress/click and
    // fight over what the modal shows next.
    document.querySelectorAll('[data-carousel-modal]').forEach(function (modal) {
      var modalImg = modal.querySelector('[data-carousel-modal-image]');
      var modalClose = modal.querySelector('[data-carousel-modal-close]');
      var modalBackdrop = modal.querySelector('[data-carousel-modal-backdrop]');
      var modalPrevBtn = modal.querySelector('[data-carousel-modal-prev]');
      var modalNextBtn = modal.querySelector('[data-carousel-modal-next]');
      var modalTitle = modal.querySelector('[data-carousel-modal-title]');
      var previouslyFocused = null;
      var active = null;

      function setModalImage() {
        if (!modalImg || !active) return;
        var img = active.images[active.getIndex()];
        if (!img) return;
        modalImg.setAttribute('src', img.getAttribute('src') || '');
        modalImg.setAttribute('alt', img.getAttribute('alt') || 'Screenshot');
        if (modalTitle) modalTitle.textContent = img.getAttribute('data-caption') || '';
      }
      function open(controller) {
        active = controller;
        previouslyFocused = document.activeElement;
        setModalImage();
        modal.classList.remove('hidden');
        (modalClose || modal).focus && (modalClose || modal).focus();
      }
      function close() {
        modal.classList.add('hidden');
        active = null;
        if (previouslyFocused && previouslyFocused.focus) previouslyFocused.focus();
      }
      function prev() { if (!active) return; active.step(-1); setModalImage(); }
      function next() { if (!active) return; active.step(1); setModalImage(); }

      modalClose && modalClose.addEventListener('click', close);
      modalBackdrop && modalBackdrop.addEventListener('click', close);
      modalPrevBtn && modalPrevBtn.addEventListener('click', prev);
      modalNextBtn && modalNextBtn.addEventListener('click', next);
      document.addEventListener('keydown', function (e) {
        if (modal.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') prev();
        if (e.key === 'ArrowRight') next();
      });

      modal._open = open;
    });

    document.querySelectorAll('[data-screenshot-carousel]').forEach(function (root) {
      var track = root.querySelector('[data-carousel-track]');
      var slides = root.querySelectorAll('[data-carousel-slide]');
      var btnPrev = root.querySelector('[data-carousel-prev]');
      var btnNext = root.querySelector('[data-carousel-next]');
      var dots = root.querySelectorAll('[data-carousel-dot]');
      if (!track || !slides.length) return;

      var index = 0;
      var images = root.querySelectorAll('[data-carousel-image]');
      var scope = root.closest('section') || document;
      var modal = scope.querySelector('[data-carousel-modal]');
      var autoplayTimer = null;

      function clamp(n) {
        return Math.max(0, Math.min(slides.length - 1, n));
      }
      function render() {
        track.style.transform = 'translateX(-' + index * 100 + '%)';
        dots.forEach(function (d, i) {
          d.style.background = i === index ? 'var(--progress-fill)' : 'var(--bg-page)';
          d.setAttribute('aria-current', i === index ? 'true' : 'false');
        });
      }
      function goTo(n) {
        index = clamp(n);
        render();
      }
      function step(delta) {
        var len = slides.length;
        goTo(((index + delta) % len + len) % len);
      }
      var controller = {
        images: images,
        getIndex: function () { return index; },
        goTo: goTo,
        step: step,
      };

      function isVisible() {
        return root.offsetParent !== null;
      }
      function stopAutoplay() {
        if (autoplayTimer) { clearInterval(autoplayTimer); autoplayTimer = null; }
      }
      function startAutoplay() {
        if (reduceMotion || slides.length < 2) return;
        stopAutoplay();
        autoplayTimer = setInterval(function () {
          if (!isVisible() || document.hidden) return;
          if (modal && !modal.classList.contains('hidden')) return;
          step(1);
        }, AUTOPLAY_MS);
      }
      function userNav(n) {
        goTo(n);
        startAutoplay();
      }
      function userStep(delta) {
        step(delta);
        startAutoplay();
      }

      btnPrev && btnPrev.addEventListener('click', function () { userStep(-1); });
      btnNext && btnNext.addEventListener('click', function () { userStep(1); });
      dots.forEach(function (d) {
        d.addEventListener('click', function () {
          var raw = d.getAttribute('data-carousel-dot');
          userNav(raw ? parseInt(raw, 10) : 0);
        });
      });
      images.forEach(function (img) {
        img.addEventListener('click', function () {
          var raw = img.getAttribute('data-carousel-image');
          var n = raw ? parseInt(raw, 10) : 0;
          userNav(n);
          if (modal && modal._open) modal._open(controller);
        });
      });

      root.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowLeft') userStep(-1);
        if (e.key === 'ArrowRight') userStep(1);
      });
      root.addEventListener('mouseenter', stopAutoplay);
      root.addEventListener('mouseleave', startAutoplay);
      root.addEventListener('focusin', stopAutoplay);
      root.addEventListener('focusout', startAutoplay);

      render();
      startAutoplay();
    });
  });
</script>
