# Polar checkout links — PRODUCTION. These are what a real visitor sees whenever
# PUBLIC_POLAR_ENV is unset or not "sandbox" (i.e. every normal deploy). Leave a
# tier empty to show "coming soon" for it instead of a dead/wrong checkout button.
PUBLIC_POLAR_PRO_YEARLY=
PUBLIC_POLAR_PRO_MONTHLY=
PUBLIC_POLAR_STUDIO_YEARLY=
PUBLIC_POLAR_STUDIO_MONTHLY=
PUBLIC_POLAR_SUPPORT_YEARLY=
PUBLIC_POLAR_SUPPORT_MONTHLY=

# Set to "sandbox" (local/dev only — never in a real deploy) to make Pricing.astro
# use the PUBLIC_POLAR_SANDBOX_* links below instead of the production ones above,
# so you can test the full checkout flow without touching real payment links.
PUBLIC_POLAR_ENV=

# Polar checkout links — SANDBOX. Only used when PUBLIC_POLAR_ENV=sandbox.
PUBLIC_POLAR_SANDBOX_PRO_YEARLY=
PUBLIC_POLAR_SANDBOX_PRO_MONTHLY=
PUBLIC_POLAR_SANDBOX_STUDIO_YEARLY=
PUBLIC_POLAR_SANDBOX_STUDIO_MONTHLY=
PUBLIC_POLAR_SANDBOX_SUPPORT_YEARLY=
PUBLIC_POLAR_SANDBOX_SUPPORT_MONTHLY=

# Base URL of a live FluxFiles instance running with FLUXFILES_DEMO=1
# (see packages/core/api/DemoMode.php in the main repo — mints a scoped,
# sandboxed, auto-expiring per-visitor token, local disk only).
# Leave empty to hide the live-demo section; the screenshot slider still
# shows either way. Example: https://demo.fluxfiles.dev
PUBLIC_DEMO_URL=
