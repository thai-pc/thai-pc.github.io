# Polar SANDBOX checkout links. Swap for the production ones before a real launch —
# the page shows no warning of its own, so a sandbox build looks like the real shop.
PUBLIC_POLAR_PRO_YEARLY=
PUBLIC_POLAR_PRO_MONTHLY=
PUBLIC_POLAR_STUDIO_YEARLY=
PUBLIC_POLAR_STUDIO_MONTHLY=

# Base URL of a live FluxFiles instance running with FLUXFILES_DEMO=1
# (see packages/core/api/DemoMode.php in the main repo — mints a scoped,
# sandboxed, auto-expiring per-visitor token, local disk only).
# Leave empty to hide the live-demo section; the screenshot slider still
# shows either way. Example: https://demo.fluxfiles.dev
PUBLIC_DEMO_URL=
